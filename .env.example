# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Supabase -> Connect -> Connection string -> "Transaction pooler" (6543-port), parol bilan
DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Ixtiyoriy uzun tasodifiy qatorlar (Vercel'da ham xuddi shunday kiritiladi)
WEBHOOK_SECRET=
CRON_SECRET=

# Chek ma'lumotini soliq.uz dan olish (true/false). soliq.uz faqat O'zbekistondan ochiladi:
# uni kompyuterdagi soliq_worker.py bajaradi. U ishlamasa, summa chek rasmidan (OCR) o'qiladi.
SOLIQ_LOOKUP=true

# IXTIYORIY (pullik): QR-kodsiz cheklarni ham o'qish uchun. Bo'sh qoldirsangiz bot tekin ishlaydi.
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Bo'sh = botdan hamma foydalana oladi (har kimning ma'lumoti alohida).
# Faqat ma'lum odamlar uchun: Telegram ID'larini vergul bilan yozing: 111,222
ALLOWED_USER_IDS=

TIMEZONE=Asia/Tashkent
# Kompyuterda (polling) ishlaganda haftalik hisobot vaqti. Vercel'da vercel.json dagi cron ishlatiladi.
WEEKLY_REPORT_HOUR=21
WEEKLY_REPORT_MINUTE=0
